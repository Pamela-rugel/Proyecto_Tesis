{
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk-xelatex",
            "command": "latexmk",
            "args": [
                "-xelatex",
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ],
            "env": {}
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "XeLaTeX (latexmk + biber)",
            "tools": ["latexmk-xelatex"]
        }
    ],
    "latex-workshop.latex.recipe.default": "first",
    // Al terminar cada compilación se borran los archivos auxiliares: solo quedan el .tex y el PDF
    "latex-workshop.latex.autoClean.run": "onBuilt",
    "latex-workshop.latex.clean.subfolder.enabled": true,
    "latex-workshop.latex.clean.fileTypes": [
        "*.aux", "*.bbl", "*.bcf", "*.blg", "*.fdb_latexmk", "*.fls", "*.lof", "*.lot", "*.log",
        "*.out", "*.run.xml", "*.synctex.gz", "*.synctex(busy)", "*.toc", "*.xdv", "*.nav", "*.snm",
        "*.idx", "*.ilg", "*.ind", "*.loa", "*.acn", "*.acr", "*.alg", "*.glg", "*.glo", "*.gls", "*.ist"
    ],
    "latex-workshop.latex.rootFile.useSubFile": false,
    "[latex]": {
        "editor.wordWrap": "on",
        "editor.wrappingIndent": "same"
    },
    "[bibtex]": {
        "editor.wordWrap": "on"
    }
}
