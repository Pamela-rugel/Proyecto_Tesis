# Copiar a stack/.env (no versionado)
# Uso: docker compose -f stack/docker-compose.yml --env-file stack/.env up -d --build

NGINX_BIND_ADDRESS=0.0.0.0
NGINX_HTTP_PORT=9095

# Frontend: base URL del API tal como la ve el navegador (ruta relativa, nginx la
# resuelve por reverse proxy - no cambiar salvo que cambie el basePath /perfiles)
VITE_API_URL=/perfiles
